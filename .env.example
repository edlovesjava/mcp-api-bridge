# Path to the catalog API config. Defaults to ./config/catalog.yaml
MCP_API_BRIDGE_CONFIG=./config/catalog.yaml

# --- Credentials referenced by config/catalog.yaml -------------------------
# Each `auth` block in the config names the env var it reads; nothing is
# ever read from the config file itself.
CATALOG_TOKEN=
PARTS_API_KEY=

# --- Bedrock ---------------------------------------------------------------
# Standard AWS credential resolution applies (env vars, shared profile,
# instance role). Only the region is required.
AWS_REGION=us-east-1
# Optional overrides:
# BEDROCK_MODEL_ID=anthropic.claude-opus-5
# BEDROCK_EFFORT=low
